{
  "name": "davidaruck-site",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/my-account/*"
    ]
  },
  "routes": [
    {
      "pattern": "davidaruck.com",
      "custom_domain": true
    },
    {
      "pattern": "www.davidaruck.com",
      "custom_domain": true
    }
  ]
}
