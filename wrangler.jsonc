{
  "name": "davidaruck-site",
  "main": "src/index.js",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/about",
      "/about/*",
      "/0199",
      "/0199/*",
      "/career",
      "/career/*",
      "/digital",
      "/digital/*",
      "/media",
      "/media/*",
      "/grid-eater",
      "/grid-eater/*",
      "/contact",
      "/contact/*",
      "/america-first",
      "/america-first/*",
      "/my-account",
      "/my-account/*",
      "/my-sister*",
      "/api/rumble/*"
    ]
  },
  "routes": [
    {
      "pattern": "davidaruck.com",
      "custom_domain": true
    },
    {
      "pattern": "www.davidaruck.com",
      "custom_domain": true
    }
  ]
}
